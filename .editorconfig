# EditorConfig — shared editor settings (VS Code reads this with the EditorConfig extension).
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Web and config files use 2 spaces by convention.
[*.{js,ts,svelte,json,yml,yaml,css,html,toml}]
indent_size = 2

# Markdown: one paragraph per line (no hard wrapping); editors soft-wrap instead.
# Two trailing spaces mean a line break in Markdown, so keep them.
[*.md]
max_line_length = off
trim_trailing_whitespace = false

# Frozen legacy app: don't let editors rewrite it.
[legacy/**]
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
