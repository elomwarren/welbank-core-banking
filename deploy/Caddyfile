# Caddy: serves the web app (static SvelteKit build) and forwards /api to the API container.
#   Development (compose profile "app"):  http://127.0.0.1:8080  (site address ":80")
#   Production (compose.prod.yaml):       WELBANK_SITE_ADDRESS=bank.example.com, and Caddy
#                                         obtains and renews a Let's Encrypt certificate itself.
{
	admin off
}

{$WELBANK_SITE_ADDRESS::80} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy same-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		-Server
	}

	handle /api/* {
		reverse_proxy api:8000
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
