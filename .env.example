# .env.example — optional settings for compose.yaml.
#
# Copy to .env and change values only if you need to. Every value below is already the default,
# so the project works without a .env file.
#
# Never put passwords here: they live in ./secrets/ (created by ./scripts/init-secrets.sh).

# Host port for the Oracle listener (bound to 127.0.0.1 only).
ORACLE_PORT=1521

# Size quota of the Fast Recovery Area (archived logs, RMAN backups, flashback logs).
FRA_SIZE=20G

# Oracle image, pinned by digest. Change deliberately when upgrading.
ORACLE_IMAGE=container-registry.oracle.com/database/free@sha256:f988b0c04c4c386cd306a2a914c0d7a9702d83acc31b064a28ad8eb6278a8fba
